{
  "name": "little-threads",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LittleThreads — hand-embroidery studio website and order CRM (React + Cloudflare Pages/D1)",
  "scripts": {
    "dev": "concurrently -k -n web,api -c magenta,green \"vite\" \"wrangler pages dev public --port 8788\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.functions.json --noEmit",
    "preview": "npm run build && wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=littlethreads",
    "db:create": "wrangler d1 create littlethreads",
    "db:local": "wrangler d1 execute littlethreads --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute littlethreads --remote --file=./schema.sql"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=20"
  }
}
