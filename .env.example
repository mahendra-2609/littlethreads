# Copy to .env and fill in. Everything is optional: without SMTP settings,
# contact-form submissions are saved to server/data/inquiries.jsonl instead.

PORT=3001

# Where contact-form enquiries are emailed to
CONTACT_TO=tejaswiande029@gmail.com

# SMTP (e.g. Gmail app password, Resend, Postmark, Mailgun...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LittleThreads Website <no-reply@littlethreads.com>"
