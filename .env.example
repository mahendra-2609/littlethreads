# Copy to .env and fill in. The .env file is gitignored.

PORT=3001

# --- Admin CRM at /admin ---
# Required to enable /admin. Use at least 8 characters.
ADMIN_PASSWORD=
# Signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Email notifications (optional) ---
# Enquiries are always saved to the CRM; SMTP only adds an email alert.
CONTACT_TO=tejaswiande029@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LittleThreads <tejaswiande029@gmail.com>"
